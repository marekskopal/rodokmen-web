# Hash of the site password – generate with: php bin/hash-password.php
SITE_PASSWORD_HASH=
# Random secret used to sign the login cookie – generate with: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
SITE_SECRET=
# Optional: slug of the default person for the ancestor explorer (defaults to the tree root)
SITE_DEFAULT_PERSON=
# Reverse proxies (addresses or CIDR ranges, comma separated) whose X-Forwarded-For / X-Forwarded-Proto are believed.
# "private" = loopback and private networks (a proxy on the same machine or in Docker). Empty = no proxy.
# E.g. SITE_TRUSTED_PROXIES=private, 203.0.113.0/24
SITE_TRUSTED_PROXIES=private
# Days the login stays valid
SITE_LOGIN_DAYS=30
# Redirect plain HTTP to HTTPS (and send HSTS). Set to 0 only when the site really runs without TLS.
SITE_FORCE_HTTPS=1
# Token of the data upload API used by bin/rodokmen-sync (empty = API disabled).
# Generate with: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
SITE_SYNC_TOKEN=
# Optional: example in the search field, e.g. "Např. Novák, Lomnice, tesař…"
SITE_SEARCH_HINT=
# Logging (Tracy, files in log/): "production" (default) or "debug" to also write debug records
SITE_LOG_LEVEL=production
# Copy every log record to stderr – Apache's error log, the container log in Docker (1 = on)
SITE_LOG_STDERR=1
