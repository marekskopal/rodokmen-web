# Settings of bin/rodokmen-sync. Copy this file into your rodokmen project folder as rodokmen-web.env
# and keep it out of git (add "rodokmen-web.env" to .gitignore) – it holds the upload token.

# Where to publish the data – one of:
#   https://rodokmen.example.org            the website's upload API (needs the token below)
#   user@server:/srv/rodokmen-web/var/data  rsync over SSH
#   ../rodokmen-web/var/data                a local folder (development)
RODOKMEN_WEB_TARGET=

# SITE_SYNC_TOKEN of the website (only for the API target).
RODOKMEN_WEB_TOKEN=
