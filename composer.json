{
    "name": "marekskopal/rodokmen-web",
    "description": "Private family tree website for genealogy projects made with the rodokmen Claude Code skill",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "laminas/laminas-diactoros": "^3.5",
        "laminas/laminas-httphandlerrunner": "^2.11",
        "league/commonmark": "^2.6",
        "marekskopal/router": "^1.3",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "tracy/tracy": "^2.10"
    },
    "autoload": {
        "psr-4": {
            "Rodokmen\\Site\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5"
        },
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "suggest": {
        "ext-gd": "With JPEG and WebP support: smaller WebP thumbnails of the scans and photos (without it the JPEGs are served)"
    },
    "require-dev": {
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^13.0",
        "shipmonk/phpstan-rules": "^4.4",
        "slevomat/coding-standard": "^8.31",
        "tomasvotruba/cognitive-complexity": "^1.3"
    },
    "autoload-dev": {
        "psr-4": {
            "Rodokmen\\Site\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=1G",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "test": "phpunit"
    }
}
